# Copy this file to .env and fill in GEMINI_API_KEY (free, no card: aistudio.google.com)
DATABASE_URL=postgres://app:app@localhost:5432/imagematch
GEMINI_API_KEY=your-gemini-api-key-here

# Models (pinned versions for reproducible results)
VISION_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# Mismatch guard thresholds (tuned with scripts/similarities.js, see BUILDLOG.md)
CONFIDENCE_MIN=0.6
MATCH_THRESHOLD=0.73
SUBJECT_THRESHOLD=0.88
TOP_K=5

# Free-tier protection
DAILY_CALL_BUDGET=500
VISION_DELAY_MS=6000
EMBED_DELAY_MS=6000

# Equivalent paid-tier prices per 1M tokens (for the cost log; actual spend is $0)
PRICE_INPUT_PER_1M=0.30
PRICE_OUTPUT_PER_1M=2.50
PRICE_EMBED_PER_1M=0.15

PORT=3000